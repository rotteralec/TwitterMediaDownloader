# Copy to .env (or export in your shell) before running.

# Secret you'll use once at /?key=<value> to unlock owner mode (unlimited downloads).
# Leave blank to disable owner mode entirely (everyone is rate-limited).
OWNER_KEY=change-me-to-something-secret

# How many extractions a non-owner IP can do per UTC day.
DAILY_LIMIT=3

# Where the "Source on GitHub" + "Host your own" links point.
GITHUB_URL=https://github.com/your-username/twitter-video-downloader

# Set to true when serving over HTTPS so the owner cookie is only sent on
# encrypted connections. Leave false for local development / plain HTTP.
COOKIE_SECURE=false

# --- GIF conversion ---------------------------------------------------------
# GIF tweets are transcoded from X's silent MP4 to a real .gif with ffmpeg at
# download time. ffmpeg must be installed (it is in the Docker image).

# Max width of the output GIF in pixels (never upscales a smaller source).
GIF_MAX_WIDTH=480

# Frames per second in the output GIF (lower = smaller file).
GIF_FPS=15

# Reject source clips larger than this many MB before converting.
GIF_MAX_SOURCE_MB=50

# Hard timeout (seconds) for each ffmpeg pass.
GIF_TIMEOUT=90
